# Variables de connexion à PostgreSQL (copier ce fichier en .env et changer le mot de passe)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=portfolio

# Utilisée par Prisma en développement local (hors Docker)
# DATABASE_URL=postgresql://portfolio:change_me_please@localhost:5432/portfolio

# Floci (émulateur AWS local, valeurs fictives)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
